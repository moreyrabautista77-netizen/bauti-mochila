# Copiá este archivo como .env y completá los valores.

PORT=3000
# Dirección desde la que abrís el panel. Si usás un túnel (necesario para TikTok), poné acá la URL https del túnel.
PUBLIC_URL=http://localhost:3000
TIMEZONE=America/Argentina/Buenos_Aires
# Cada cuántas horas se actualizan solas las estadísticas.
SYNC_EVERY_HOURS=6
# Contraseña para entrar al panel (usuario: cualquiera). OBLIGATORIA si lo exponés a internet.
DASHBOARD_PASSWORD=

# Meta (Facebook + Instagram) — developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0

# TikTok — developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
